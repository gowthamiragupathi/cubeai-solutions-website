# =================================================================
# CUBE AI SOLUTION - ENVIRONMENT CONFIGURATION
# =================================================================

# Backend Database (PostgreSQL URL with fallback to SQLite if needed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cube_db
# Alternative for local development without PostgreSQL:
# DATABASE_URL=sqlite:///./cube.db

# JWT & Authentication Secret
SECRET_KEY=cube_ai_super_secret_jwt_key_2026_enterprise_secure_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Seed Credentials
ADMIN_EMAIL=admin@cubeai.com
ADMIN_PASSWORD=Admin@Cube2026!
ADMIN_NAME="Cube Administrator"

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Media Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Vite Frontend API Base URL (used in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api
